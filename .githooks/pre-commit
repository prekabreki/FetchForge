#!/bin/sh
# init-workspace pre-commit: keep .memories/README.md in sync with memory frontmatter.
# Fires only when this commit touches .memories/ (excluding the generated index), so
# unrelated commits stay fast. Regenerates the index and stages it.
# No Python means the index cannot be refreshed, so the commit is refused rather than
# letting the index silently go stale.
changed=$(git diff --cached --name-only -- .memories/ ':(exclude).memories/README.md')
if [ -n "$changed" ]; then
  repo_root=$(git rev-parse --show-toplevel)
  if command -v python >/dev/null 2>&1; then
    py=python
  elif command -v python3 >/dev/null 2>&1; then
    py=python3
  else
    echo "init-workspace pre-commit: neither python nor python3 found; cannot refresh .memories/README.md." >&2
    echo "Install Python, or commit with --no-verify and regenerate the index later." >&2
    exit 1
  fi
  "$py" "$repo_root/tools/memory-index.py" || exit 1
  git add "$repo_root/.memories/README.md"
fi
